      "internal_covariance_weight": 1.0,
      "normalized_aux_weight": 0.30,
      "negative_samples": false
    },
    "PROTO": {
      "type": "soft prototype consensus across modality-shared and fused embeddings",
      "prototype_count": "locked benchmark K",
      "student_temperature": 0.10,
      "teacher_ema": 0.99,
      "occupancy_regularizer": "weak KL to EMA occupancy; no exact equal-cluster constraint",
      "normalized_aux_weight": 0.10
    },
    "RNA_ANCHOR": {
      "active_family": "RNA_EPIGENOME",
      "topology": "sparse intersection of spatial edges and RNA-feature neighbor edges, with self loops",
      "inactive_behavior": "identity/no-op with content-addressed artifact aliasing allowed"
    },
    "DGI": {
      "type": "sparse global-local mutual-information objective",
      "normalized_aux_weight": 0.10,
      "dense_n_by_n_forbidden": true
    },
    "SMART_TRIPLET": {
      "type": "independent SMART-style distant metric-learning control",
      "mnn_k": 3,
      "farthest_fraction": 0.60,
      "margin": 0.50,
      "normalized_aux_weight": 0.10
    },
    "loss_scale_normalization": {
      "formula": "L_base + lambda_i * clip(EMA(abs(L_base))/(EMA(abs(L_i))+1e-8),0.1,10.0) * L_i",
      "ema_beta": 0.99,
      "warmup_epochs": 10,
      "gradient_through_scale": false
    }
